		forecolor		1 1 1 1
		textfont		UI_FONT_NORMAL
		text			"Actual killcard Icono"
		textalign		ITEM_ALIGN_LEFT
		textscale		TEXTSIZE_SMALL
		textaligny		18
		visible			1
		decoration
	}	
#define	SPRAY_BUT( row, col, num, resp )	\
		itemDef	\
		{	\
			rect			(5+col*63) (150+row*63) 60 60 23 78	\
			style			WINDOW_STYLE_SHADER	\
			type 			ITEM_TYPE_BUTTON	\
			border			1	\
			bordercolor		THEMECOLOR 0.5;	\
			exp				material( "killcard" + num + "_menu")	\
			textfont		UI_FONT_NORMAL	\
			textalign		ITEM_ALIGN_LEFT	\
			textscale		TEXTSIZE_SMALL	\
			visible			when( dvarint("cpage") == 3 );	\
			action			{ play mouse_click;scriptmenuresponse resp; }	\
			mouseEnter		{ play "mouse_over"; setcolor bordercolor 255 0 0 1; }	\
			mouseExit		{ setcolor bordercolor THEMECOLOR 0.5; }	\
		}

	SPRAY_BUT( 0, 0,  0, killcard0_menu )
