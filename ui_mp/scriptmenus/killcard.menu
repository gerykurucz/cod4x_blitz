#define THEMECOLOR 0.5 0.5 0.5

menudef
{
	name			"killcard"
	rect			0 0 640 480
	visible			1
	focuscolor		COLOR_FOCUSED
	onopen			{ focusFirst;exec "set cpage 3"; }
	onEsc			{ close self; }
