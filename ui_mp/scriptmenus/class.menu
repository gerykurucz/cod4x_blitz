#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"

#define CHOICE_SIZE_X			150
#define CHOICE_SIZE_Y			22

#define CHOICE_X_START			0
#define CHOICE_Y_START			180 //180

#define CHOICE_GROUP			"class"
#define CHOICE_SEP_1			3

#include "ui_mp/menustyle.inc"
#include "ui_mp/choices_setup_teams.menu"

#define ORIGIN_DESCRIPTION		(CHOICE_X_START + 15) 190

{
	menuDef
	{
		name			"class"
		rect			0 0 640 480
		focuscolor		COLOR_FOCUSED
		style			WINDOW_STYLE_EMPTY
		blurWorld		0
		visible 		when( dvarInt(ui_showEndOfGame) == 0 ); 

		onOpen {
			focusFirst;
			execnow "set ui_showEndOfGame 0";
			// Kill the specific background layers
			hidemenu "endofgame";
			close "endofgame";
		}
		
		onEsc 
		{
			close self;
			setdvar ui_showEndOfGame "0";
		}
		onClose
		{
			setdvar ui_showEndOfGame "0";
		}
		#ifndef PC
		execkeyint BUTTON_START
		{
			scriptMenuResponse "back";
			setdvar ui_showEndOfGame "0";
		}
		#endif
		
		// background overlay
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			backcolor		0 0 0 0.75 //0 0.05 0.15 0.5
			visible			1
			decoration
		}

		// gradient_top
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			0 0 854 75 HORIZONTAL_ALIGN_FULLSCREEN 0
			background		"gradient_top"
			visible			1
			decoration
		}

		// gradient_bottom
		itemDef
		{
			style			WINDOW_STYLE_SHADER
			rect			0 405 854 75 HORIZONTAL_ALIGN_FULLSCREEN 0
			background		"gradient_bottom"
			visible			1
			decoration
		}
		
		CHOICE_MENU_TITLE( "Options" )
		
		// ------------------ buttons ---------------------
		#define BACK_OPEN	;
		#include "ui_mp/navcontrols.inc"
		//=========================================================
		//===================== MENU SELECTION ====================
		//=========================================================
		#include "ui_mp/teamicon.inc"

    // PC widescreen fix
		#undef  CHOICE_X_START
		#define CHOICE_X_START    -320
		#undef    CHOICE_HORIZONTAL_ALIGN
		#define CHOICE_HORIZONTAL_ALIGN HORIZONTAL_ALIGN_CENTER

		CHOICE_BUTTON_VIS( 1, "Default Class", scriptMenuResponse "changeclass_marines", when( (TEAM_IS_MARINES && MAY_CHOOSE_CLASS) && team( name ) != "TEAM_SPECTATOR" ) )
		CHOICE_BUTTON_VIS( 1, "Default Class", scriptMenuResponse "changeclass_opfor", when( TEAM_IS_OPFOR && MAY_CHOOSE_CLASS && team( name ) != "TEAM_SPECTATOR") )
		
		#define SETUP_ACTION_CREATEACLASS \
			close self; \				
			execnow "statset 260 1"; \
			play "mouse_click"; \
			open menu_cac_sniper;

		CHOICE_BUTTON_VIS( 2, "Custom Class", SETUP_ACTION_CREATEACLASS, when( TEAM_IS_MARINES && MAY_CHOOSE_CLASS && team( name ) != "TEAM_SPECTATOR") )
		CHOICE_BUTTON_VIS( 2, "Custom Class", SETUP_ACTION_CREATEACLASS, when( TEAM_IS_OPFOR && MAY_CHOOSE_CLASS && team( name ) != "TEAM_SPECTATOR") )
		
		#define JOIN_AS_SPEC \				
			play "mouse_click"; \
			scriptMenuResponse "autoassign"; \
			name "auto_assign"
		
		#define JOIN_SPEC \
			play "mouse_click"; \
			scriptMenuResponse "spectator";
		
		CHOICE_BUTTON_VIS( 3, "Join Game", JOIN_AS_SPEC, when( team( name ) == "TEAM_SPECTATOR" || team( name ) == "TEAM_FREE" ) )
		CHOICE_BUTTON_VIS( 3, "Join Spectators", JOIN_SPEC, when( team( name ) != "TEAM_SPECTATOR") )

		CHOICE_SEPARATOR_VIS( CHOICE_SEP_1, when( !localvarBool( ui_hideBack ) ) )
		
		CHOICE_BUTTON_VIS( 4, "Challanges", close self; open menu_challenges;, when( !localvarBool( ui_hideBack ) ) )
		
		CHOICE_BUTTON( 5, "killcard Settings", close self;open "killcard"; )

		CHOICE_BUTTON( 6, "Spray Settings", close self;open "spray"; )
		CHOICE_BUTTON( 7, "@MENU_CONTROLS", close self; open main_controls )
		
		CHOICE_BUTTON( 8, "@MENU_OPTIONS", close self; open main_options; )
		
		CHOICE_BUTTON( 9, "@MENU_LEAVE_GAME", open popup_leavegame; )
    
		#include "ui/safearea.menu"
	}
}



